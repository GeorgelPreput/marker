FROM nvidia/cuda:13.4.1-cudnn-devel-ubuntu24.04

ARG LD_LIBRARY_PATH

RUN apt-get update && apt-get upgrade -y && \
    apt-get install --no-install-recommends -y \
    build-essential curl wget python-is-python3 software-properties-common \
    zlib1g-dev libjpeg-dev libpng-dev libtiff-dev libfreetype6-dev \
    liblcms2-dev libwebp-dev libopenjp2-7-dev \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-noto-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN wget "https://developer.download.nvidia.com/compute/cuda/repos/debian12/sbsa/cuda-keyring_1.1-1_all.deb" && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    rm cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get -y install libcusparselt0-cuda-13 libcusparselt0-dev-cuda-13

RUN userdel -r ubuntu && \
    useradd --uid 1000 --create-home --shell /bin/bash app
ENV HOME=/home/app

USER app
WORKDIR /home/app

ADD --chown=app:app https://astral.sh/uv/install.sh install.sh
RUN chmod -R 755 install.sh && ./install.sh && rm install.sh

ENV PATH="/home/app/.local/bin:${PATH}"

# Surya 0.22 OCR/recognition spawns llama-server; ship a pinned llama.cpp build.
# cudart bundle includes the CUDA 13.4 runtime, so it runs regardless of the image toolkit.
ARG LLAMA_TAG=b11135
RUN curl -fsSL -o /tmp/llama.tar.gz \
      "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_TAG}/cudart-llama-${LLAMA_TAG}-bin-ubuntu-cuda-13.4-arm64.tar.gz" && \
    echo "1a5ebc98080f03667513229987a28cf8da3ef058c1299c94f8c573ee0b6f46d7  /tmp/llama.tar.gz" | sha256sum -c - && \
    mkdir -p /home/app/.local/llama.cpp && \
    tar xzf /tmp/llama.tar.gz -C /home/app/.local/llama.cpp --strip-components=1 && \
    rm /tmp/llama.tar.gz
ENV PATH="/home/app/.local/llama.cpp:${PATH}"
ENV LD_LIBRARY_PATH="/home/app/.local/llama.cpp:${LD_LIBRARY_PATH}"
RUN llama-server --version

COPY pyproject-gpu.toml pyproject.toml
RUN uv sync

ENV PATH="/home/app/.venv/bin:${PATH}"
COPY --chown=app:app marker_sitecustomize.py /home/app/marker-patch/sitecustomize.py
ENV PYTHONPATH="/home/app/marker-patch"
RUN python -c "from marker.providers.powerpoint import PowerPointProvider; assert PowerPointProvider._handle_image.__module__ == 'sitecustomize'"
ENV LD_LIBRARY_PATH="/usr/local/cuda-13.0/lib64:${LD_LIBRARY_PATH}"
ENV CUDA_HOME="/usr/local/cuda-13.0"

EXPOSE 8001

CMD ["marker_server", "--host", "0.0.0.0", "--port", "8001"]
