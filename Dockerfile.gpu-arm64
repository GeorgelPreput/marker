# Surya OCR needs no CUDA base image or host toolkit: llama.cpp bundles its CUDA 13.4
# runtime in the tarball below, and torch vendors CUDA via its pip wheels (cu130 index).
# The NVIDIA driver is injected from the host by the container toolkit at runtime.
FROM python:3.14.7-slim-trixie

RUN apt-get update && apt-get upgrade -y && \
    apt-get install --no-install-recommends -y \
    build-essential curl wget python-is-python3 \
    zlib1g-dev libjpeg-dev libpng-dev libtiff-dev libfreetype6-dev \
    liblcms2-dev libwebp-dev libopenjp2-7-dev \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-noto-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 1000 --create-home --shell /bin/bash app
ENV HOME=/home/app

USER app
WORKDIR /home/app

ADD --chown=app:app https://astral.sh/uv/install.sh install.sh
RUN chmod -R 755 install.sh && ./install.sh && rm install.sh

ENV PATH="/home/app/.local/bin:${PATH}"

# Surya 0.22 OCR/recognition spawns llama-server; ship a pinned llama.cpp build.
# The cuda build provides the binaries; the cudart bundle provides the CUDA 13.4 runtime
# (libcudart/libcublas) the binaries are linked against.
ARG LLAMA_TAG=b11135
RUN curl -fsSL -o /tmp/llama.tar.gz \
      "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_TAG}/llama-${LLAMA_TAG}-bin-ubuntu-cuda-13.4-arm64.tar.gz" && \
    echo "4785998221cd4bf9544489da96f131dd0b987df3c51359b68b2f7a140cc10c52  /tmp/llama.tar.gz" | sha256sum -c - && \
    curl -fsSL -o /tmp/llama-cudart.tar.gz \
      "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_TAG}/cudart-llama-${LLAMA_TAG}-bin-ubuntu-cuda-13.4-arm64.tar.gz" && \
    echo "1a5ebc98080f03667513229987a28cf8da3ef058c1299c94f8c573ee0b6f46d7  /tmp/llama-cudart.tar.gz" | sha256sum -c - && \
    mkdir -p /home/app/.local/llama.cpp && \
    tar xzf /tmp/llama.tar.gz -C /home/app/.local/llama.cpp --strip-components=1 && \
    tar xzf /tmp/llama-cudart.tar.gz -C /home/app/.local/llama.cpp --strip-components=1 && \
    rm /tmp/llama.tar.gz /tmp/llama-cudart.tar.gz
ENV PATH="/home/app/.local/llama.cpp:${PATH}"
RUN llama-server --version

COPY pyproject-gpu.toml pyproject.toml
RUN uv sync

ENV PATH="/home/app/.venv/bin:${PATH}"
COPY --chown=app:app marker_sitecustomize.py /home/app/marker-patch/sitecustomize.py
ENV PYTHONPATH="/home/app/marker-patch"

# Surya auto-selects a vLLM backend on NVIDIA GPUs, which requires docker-in-container.
# Pin llama.cpp: it is shipped in this image and uses the GPU via the CUDA llama-server.
ENV SURYA_INFERENCE_BACKEND="llamacpp"
RUN python -c "from marker.providers.powerpoint import PowerPointProvider; assert PowerPointProvider._handle_image.__module__ == 'sitecustomize'"

EXPOSE 8001
CMD ["marker_server", "--host", "0.0.0.0", "--port", "8001"]
